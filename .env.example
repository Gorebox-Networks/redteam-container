# Example environment file for redteam-container.
#
# Copy to `env` (the compose file reads `env_file: - .env`; the build context
# reads `env`) and fill in real values. NEVER commit the filled-in file.
#
# The root password is applied at RUNTIME, not at build time. It is never
# baked into an image layer, and it is never stored in git history.
#
#   cp .env.example env     # then edit `env`

# SSH
# Root password. If this is empty or unset the container refuses to enable SSH
# password authentication and will only accept key-based login. There is no
# default password and no empty-password fallback.
SSHPASSWORD=
RTSSHHOSTPORT=3022

# RedTeam
BASEVOLUME=/opt/redteam